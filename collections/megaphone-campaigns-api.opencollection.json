{
  "opencollection": "1.0.0",
  "info": {
    "name": "Megaphone Campaigns API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Campaigns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List campaigns (legacy Direct Sales)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cms.megaphone.fm/api/organizations/:organization_id/campaigns",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization identifier for Direct Sales resources."
              }
            ]
          },
          "docs": "Lists direct-sales campaigns for an organization. Legacy v1 endpoint being superseded by v2."
        }
      ]
    }
  ],
  "bundled": true
}