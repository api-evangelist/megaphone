{
  "opencollection": "1.0.0",
  "info": {
    "name": "Megaphone Campaigns Networks API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Networks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a network",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cms.megaphone.fm/api/networks/:network_id",
            "params": [
              {
                "name": "network_id",
                "value": "",
                "type": "path",
                "description": "The network (account container) identifier."
              }
            ]
          },
          "docs": "Retrieves a single network (account container) by ID."
        }
      ]
    }
  ],
  "bundled": true
}